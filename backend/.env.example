APP_NAME=DentalAI Copilot
DATABASE_URL=postgresql+psycopg://dentalai:dentalai@localhost:5438/dentalai
DOX_MYSQL_URL=
DOX_MYSQL_HOST=127.0.0.1
DOX_IMPORT_PATIENT_LIMIT=10
DOX_IMPORT_BATCH_SIZE=200
UPLOAD_DIR=uploads
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
# 向量模型独立于聊天模型；使用上面的 OPENROUTER_API_KEY，或单独设置密钥。
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2
# 长度单位是 UTF-8 字节，不是字符或精确 token 数；为 512-token 模型保守留量。
RAG_CHUNK_SIZE=480
RAG_CHUNK_OVERLAP=72
# 免费 Liquid 端点可能保留输入用于训练；本演示仅使用合成资料。
# 完全离线教学：EMBEDDING_PROVIDER=hash 且 MOCK_LLM=true，切换后须重建向量。
MOCK_LLM=false
# 本地 HTTP 使用 false；HTTPS 部署必须设为 true。
COOKIE_SECURE=false
# JSON 数组；仅允许这些前端 Origin 发起带 Cookie 的跨域请求。
ALLOWED_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]
